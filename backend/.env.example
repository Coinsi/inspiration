# 复制为 .env 并按需修改
# ── 应用 ──
APP_NAME=Inspiration
APP_ENV=dev
SECRET_KEY=change-me-in-production-please-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── 数据库 (PostgreSQL + pgvector) ──
DATABASE_URL=postgresql+psycopg://inspiration:inspiration@postgres:5432/inspiration

# ── Redis / Celery ──
REDIS_URL=redis://redis:6379/0
# 单机开发可设 local，使用后台线程，不依赖 Redis。生产多进程部署使用 celery。
GENERATION_EXECUTOR=celery
CELERY_EAGER=false

# ── 对象存储 ──
# STORAGE_BACKEND: minio(生产/S3 兼容) | fs(本地文件系统,无需 MinIO,轻量自托管)
STORAGE_BACKEND=minio
FS_STORAGE_DIR=./_storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=inspiration
MINIO_SECURE=false

# ── 密钥加密 (供应商 API Key 等), 32 字节 base64 ──
CREDENTIALS_FERNET_KEY=

# ── 特性开关 ──
# pgvector(相似检索 EXT-01)。docker 用 pgvector 镜像可保持 true;
# 连接未安装该扩展的普通 Postgres 时置 false,自动降级不建向量列。
ENABLE_PGVECTOR=true

# ── 素材处理扩展（先部署对应服务，再启用；配置不代表模型已经验证） ──
# 上传暂存的预约上限与最低空闲空间；失败任务保留源文件，取消后释放预约。
# 这不是对象存储或 Docker 数据卷的硬配额。
LIBRARY_MAX_UPLOAD_BYTES=10737418240
LIBRARY_STAGING_MAX_BYTES=107374182400
LIBRARY_STAGING_RESERVE_BYTES=2147483648
LIBRARY_PROCESSING_ENABLED=false
LIBRARY_PROCESSING_AUTO=false
# Automatically process only these enabled WISE capabilities. Keep object/face
# on demand unless explicitly added here after model deployment and validation.
LIBRARY_PROCESSING_WISE_AUTO_CAPABILITIES=["visual","audio"]
LIBRARY_WISE_URL=http://127.0.0.1:9671
LIBRARY_WISE_TOKEN=
LIBRARY_WISE_CAPABILITIES=["visual"]
LIBRARY_MEDIACMS_URL=http://127.0.0.1:18080
LIBRARY_MEDIACMS_TOKEN=
LIBRARY_MEDIACMS_TRANSCRIPTION_ENABLED=false
LIBRARY_PROCESSING_POLL_SECONDS=10
LIBRARY_PROCESSING_TEMP_DIR=./_media_processing
LIBRARY_PROCESSING_RESERVE_BYTES=2147483648
LIBRARY_PROCESSING_MAX_TRANSFER_BYTES=53687091200
