# 复制为 .env 并按需修改
# ── 应用 ──
APP_NAME=Inspiration
APP_ENV=dev
SECRET_KEY=change-me-in-production-please-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── 数据库 (PostgreSQL + pgvector) ──
DATABASE_URL=postgresql+psycopg://inspiration:inspiration@postgres:5432/inspiration

# ── Redis / Celery ──
REDIS_URL=redis://redis:6379/0
# 单机开发可设 local，使用后台线程，不依赖 Redis。生产多进程部署使用 celery。
GENERATION_EXECUTOR=celery
CELERY_EAGER=false

# ── 对象存储 ──
# STORAGE_BACKEND: minio(生产/S3 兼容) | fs(本地文件系统,无需 MinIO,轻量自托管)
STORAGE_BACKEND=minio
FS_STORAGE_DIR=./_storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=inspiration
MINIO_SECURE=false

# ── 密钥加密 (供应商 API Key 等), 32 字节 base64 ──
CREDENTIALS_FERNET_KEY=

# ── 特性开关 ──
# pgvector(相似检索 EXT-01)。docker 用 pgvector 镜像可保持 true;
# 连接未安装该扩展的普通 Postgres 时置 false,自动降级不建向量列。
ENABLE_PGVECTOR=true
