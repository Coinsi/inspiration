# Copy to .env (ignored by Git), replacing each placeholder with a random value.
# Never print `docker compose config` with a real private env: it expands secrets.
MEDIACMS_DJANGO_SECRET=replace-with-a-random-secret-of-at-least-48-characters
MEDIACMS_DB_PASSWORD=replace-with-a-random-password-of-at-least-32-characters
MEDIACMS_ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-32-characters
# Exactly 40 lowercase hex characters, generated from 20 random bytes.
MEDIACMS_SERVICE_TOKEN=replace-with-40-lowercase-hex-characters
MEDIACMS_PORT=18080
# Explicit enablement may download a Whisper model on first transcription.
MEDIACMS_ENABLE_TRANSCRIPTION=false
MEDIACMS_WHISPER_MODEL=base
# Soft reserve checked during upload and once a second during processing; not a quota.
MEDIACMS_DISK_RESERVE_BYTES=10737418240
WISE_BRIDGE_TOKEN=replace-with-a-separate-random-secret-at-least-24-characters
WISE_PORT=9671
# Starts without fetching model weights. Disable only when provisioning models.
WISE_OFFLINE=1
# Optional models remain off until local artifacts, purpose and probe are verified.
WISE_BRIDGE_CAPABILITIES=visual,audio
# object allows development_evaluation; face needs its own explicit licensed use.
WISE_OPTIONAL_USE=unspecified
# Bounded resident query cache; increase only after measuring actual memory.
WISE_QUERY_CACHE_MODELS=1
WISE_QUERY_CACHE_PROJECTS=2
WISE_QUERY_CACHE_INDEX_BYTES=536870912
