# Reference for the 1Panel-managed reverse-proxy site coinisi.com.
# Preserve 1Panel's generated certificate, ACME, logging and include sections.
# OpenResty uses host networking; the upstream is the host loopback port.
server {
    listen 80;
    server_name coinisi.com;
    # Reject unknown Host values before passing an origin to background jobs.
    # For this single-domain site, changing server_name is sufficient when moving domains.
    if ($host != $server_name) { return 444; }
    client_max_body_size 260m;
    client_body_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
