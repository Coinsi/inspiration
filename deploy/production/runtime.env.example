# Private server file: /opt/inspiration/runtime.env (chmod 600).
# Generate passwords using hex characters so DATABASE_URL remains valid.
POSTGRES_PASSWORD=replace-with-random-hex
WEB_BIND=127.0.0.1
WEB_PORT=18080
APP_ENV=prod
SECRET_KEY=replace-with-random-hex
CREDENTIALS_FERNET_KEY=replace-with-generated-fernet-key
GENERATION_EXECUTOR=celery
CELERY_EAGER=false
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=inspiration-storage
MINIO_SECRET_KEY=replace-with-random-hex
MINIO_BUCKET=inspiration
MINIO_SECURE=false
ENABLE_PGVECTOR=true
FS_STORAGE_DIR=/data/storage
LIBRARY_STAGING_DIR=/data/library-staging
LIBRARY_PROCESSING_TEMP_DIR=/data/media-processing
LIBRARY_MAX_UPLOAD_BYTES=536870912
LIBRARY_STAGING_MAX_BYTES=2147483648
LIBRARY_STAGING_RESERVE_BYTES=3221225472
ARCHIVE_STAGING_QUOTA_BYTES=2147483648
ARCHIVE_PROJECT_QUOTA_BYTES=2147483648
ARCHIVE_DISK_HEADROOM_BYTES=3221225472
LIBRARY_PROCESSING_ENABLED=false
LIBRARY_PROCESSING_AUTO=false
LIBRARY_INDEXER_URL=
LIBRARY_WISE_URL=
LIBRARY_MEDIACMS_URL=
TRANSCRIBER_URL=
TRANSCRIPTION_WORKER_ENABLED=false
